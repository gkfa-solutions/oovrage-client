#!/bin/bash
# En-tête du connecteur MCP du plugin : imprime `{"X-Oovrage-Projet":"<slug>"}`
# (plus `"X-Oovrage-Organisation":"<id>"` si le champ `organisation` est un slug
# valide) si `<dossier>/.oovrage-client.json` existe et que son champ `projet`
# est un slug valide ; sinon `{}` (le connecteur part sans projet : la plateforme
# répond `projet_absent`, jamais un en-tête invalide). Toujours code 0.
#
# Appelé par Claude Code (`headersHelper` de `.mcp.json`) avec le dossier de la
# session en argument. Bash pur : ni jq, ni node, ni python chez le client.

# Le premier dossier qui a le fichier : l'argument, puis CLAUDE_PROJECT_DIR (si
# l'argument arrive vide ou non développé), puis le dossier courant. Séparateurs
# Windows `\` ramenés à `/`.
fichier=""
for dossier in "${1:-}" "${CLAUDE_PROJECT_DIR:-}" "$(pwd)"; do
  [ -n "$dossier" ] || continue
  dossier="${dossier//\\//}"
  if [ -f "$dossier/.oovrage-client.json" ]; then
    fichier="$dossier/.oovrage-client.json"
    break
  fi
done

vide() {
  printf '{}\n'
  exit 0
}

[ -n "$fichier" ] || vide
contenu="$(tr -d '\n\r' < "$fichier" 2>/dev/null)" || vide

# Un objet JSON, au moins en apparence : `{` … `}`.
nu="$(printf '%s' "$contenu" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
case "$nu" in
  \{*\}) ;;
  *) vide ;;
esac

# Exactement un champ `projet`, chaîne sans guillemet ni échappement.
valeurs="$(printf '%s' "$nu" | grep -o '"projet"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*:[[:space:]]*"\([^"]*\)"$/\1/')"
[ "$(printf '%s\n' "$valeurs" | grep -c .)" -eq 1 ] || vide
[[ "$valeurs" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || vide

# Le champ `organisation`, même règle, facultatif : absent, en double ou invalide,
# il est simplement omis (l'en-tête du projet part quand même).
organisations="$(printf '%s' "$nu" | grep -o '"organisation"[[:space:]]*:[[:space:]]*"[^"]*"' | sed 's/.*:[[:space:]]*"\([^"]*\)"$/\1/')"
if [ "$(printf '%s\n' "$organisations" | grep -c .)" -eq 1 ] && [[ "$organisations" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]; then
  printf '{"X-Oovrage-Projet":"%s","X-Oovrage-Organisation":"%s"}\n' "$valeurs" "$organisations"
else
  printf '{"X-Oovrage-Projet":"%s"}\n' "$valeurs"
fi
